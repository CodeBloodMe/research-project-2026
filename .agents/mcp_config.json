{
  "mcpServers": {
    "zotero": {
      "command": "uvx",
      "args": ["zotero-mcp-server"]
    },
    "semantic-scholar": {
      "command": "npx",
      "args": ["-y", "semantic-scholar-mcp"]
    },
    "openalex": {
      "command": "npx",
      "args": ["-y", "openalex-mcp"]
    },
    "crossref": {
      "command": "npx",
      "args": ["-y", "crossref-mcp"]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<YOUR_GITHUB_TOKEN_HERE>"
      }
    }
  }
}
